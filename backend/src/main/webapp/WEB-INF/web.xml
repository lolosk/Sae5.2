<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Casino Online</display-name>
    <description>Mini casino en ligne - Projet Saé502</description>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

    <!-- Context parameters for database -->
    <context-param>
        <param-name>DB_URL</param-name>
        <param-value>jdbc:postgresql://localhost:5432/casino_db</param-value>
    </context-param>
    
    <context-param>
        <param-name>DB_USER</param-name>
        <param-value>casino_user</param-value>
    </context-param>
    
    <context-param>
        <param-name>DB_PASSWORD</param-name>
        <param-value>casino_pass</param-value>
    </context-param>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.html</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.html</location>
    </error-page>

</web-app>